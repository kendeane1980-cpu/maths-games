{
  "rules": {
    ".read": false,
    ".write": false,
    "matches": {
      ".indexOn": ["createdAt"],
      ".read": "auth != null && query.orderByChild === 'createdAt' && query.endAt <= now - 86400000 && query.limitToFirst <= 50",
      "$code": {
        ".read": "auth != null && $code.matches(/^[A-Z]{4}$/)",
        ".write": "auth != null && $code.matches(/^[A-Z]{4}$/) && ((!data.exists() && newData.child('host').val() === auth.uid) || (data.exists() && newData.exists() && (data.child('host').val() === auth.uid || data.child('guest').val() === auth.uid || (!data.child('guest').exists() && newData.child('guest').val() === auth.uid))) || (data.exists() && !newData.exists() && (data.child('host').val() === auth.uid || data.child('createdAt').val() < now - 86400000)))",
        ".validate": "newData.hasChildren(['host', 'createdAt', 'count', 'state'])",
        "host": { ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())" },
        "guest": { ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())" },
        "createdAt": { ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : newData.val() === now)" },
        "count": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 30 && (!data.exists() || newData.val() === data.val())" },
        "state": { ".validate": "newData.isString() && newData.val().matches(/^(lobby|playing|done)$/)" },
        "turn": { ".validate": "newData.isNumber() && (newData.val() === 0 || newData.val() === 1)" },
        "p": {
          "$i": {
            ".validate": "($i === '0' || $i === '1') && newData.hasChildren(['name', 'kit', 'digits', 'carry'])",
            "name": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "kit": { ".validate": "newData.isString() && newData.val().length <= 10" },
            "digits": { ".validate": "newData.isNumber() && (newData.val() === 2 || newData.val() === 3)" },
            "carry": { ".validate": "newData.isBoolean()" },
            "online": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },
        "kicks": {
          "$i": {
            ".validate": "$i === '0' || $i === '1'",
            "$k": {
              ".validate": "$k.matches(/^[0-9]{1,2}$/) && !data.exists() && newData.hasChildren(['a', 'b', 'given', 'ok', 'ms'])",
              "a": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1000" },
              "b": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1000" },
              "given": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 10000" },
              "ok": { ".validate": "newData.isBoolean()" },
              "ms": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 3600000" },
              "$other": { ".validate": false }
            }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
